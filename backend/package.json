{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:generate": "prisma generate --config=./prisma7.config.ts",
    "db:validate": "prisma validate --config=./prisma7.config.ts",
    "db:format": "prisma format --config=./prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config=./prisma7.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config=./prisma7.config.ts",
    "db:seed": "prisma db seed --config=./prisma7.config.ts",
    "db:studio": "prisma studio --config=./prisma7.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.14",
    "eslint": "^9.33.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "prisma": "^7.10.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.1"
  }
}
