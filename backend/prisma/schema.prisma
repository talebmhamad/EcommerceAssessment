// Prisma schema for the backend database foundation.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductType {
  SIMPLE
  CONFIGURABLE
}

enum VariantOptionType {
  SIZE
  COLOR
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique @db.VarChar(320)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orders        Order[]

  @@map("users")
}

model Product {
  id            Int              @id @default(autoincrement())
  slug          String           @unique @db.VarChar(160)
  title         String           @db.VarChar(200)
  description   String           @db.Text
  price         Decimal          @db.Decimal(12, 2)
  type          ProductType      @default(SIMPLE)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  variants      ProductVariant[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@map("products")
}

model ProductVariant {
  id            Int                @id @default(autoincrement())
  productId     Int                @map("product_id")
  sku           String             @unique @db.VarChar(64)
  label         String             @db.VarChar(120)
  optionType    VariantOptionType? @map("option_type")
  optionValue   String?            @map("option_value") @db.VarChar(60)
  stockQuantity Int                @default(0) @map("stock_quantity")
  isDefault     Boolean            @default(false) @map("is_default")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, id])
  @@unique([productId, optionType, optionValue])
  @@index([productId])
  @@map("product_variants")
}

model CartItem {
  id        Int @id @default(autoincrement())
  userId    Int @map("user_id")
  productId Int @map("product_id")
  variantId Int @map("variant_id")
  quantity  Int

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productId, variantId], references: [productId, id], onDelete: Cascade)

  @@unique([userId, productId, variantId])
  @@index([userId])
  @@index([productId])
  @@index([productId, variantId])
  @@map("cart_items")
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlist_items")
}

model Order {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  finalTotal Decimal  @map("final_total") @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id                   Int     @id @default(autoincrement())
  orderId              Int     @map("order_id")
  productId            Int     @map("product_id")
  variantId            Int     @map("variant_id")
  quantity             Int
  unitPrice            Decimal @map("unit_price") @db.Decimal(12, 2)
  productTitleSnapshot String  @map("product_title_snapshot") @db.VarChar(200)
  variantLabelSnapshot String  @map("variant_label_snapshot") @db.VarChar(120)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [productId, variantId], references: [productId, id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([productId, variantId])
  @@map("order_items")
}
